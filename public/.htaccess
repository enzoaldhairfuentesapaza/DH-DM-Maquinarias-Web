Options -Indexes
RewriteEngine On
RewriteRule ^api(?:/|$) - [L]
# SPA routes take precedence over homonymous image directories.
RewriteRule ^(?:repuestos|maquinaria|nosotros|blog|novedades|promociones|contacto|cotizacion|login|registro|perfil|cotizador|admin)/?$ /index.html [END]
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]
RewriteRule ^ /index.html [END]
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  <Files "index.html">
    Header set Cache-Control "no-cache"
  </Files>
</IfModule>
