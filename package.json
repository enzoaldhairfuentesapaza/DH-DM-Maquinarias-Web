{
  "name": "paginahdm",
  "private": true,
  "version": "2.1.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/sync-vendor.mjs && vite",
    "build": "node scripts/check-images.mjs && node scripts/sync-vendor.mjs && tsc && vite build",
    "lint": "eslint . --max-warnings 0",
    "preview": "vite preview",
